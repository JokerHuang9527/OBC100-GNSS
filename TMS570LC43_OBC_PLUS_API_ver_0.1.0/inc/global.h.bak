/* mode.
 * 0: debug, print DMA time
 * 1: data 10b
 * 2: data 8b
 * 3: pending
 * other: debug, print nothing
 * */
extern volatile int gmode;
/* output mode.
 * 0: debug, print FPS
 * 1: uart - data 10b
 * 2: uart - data 8b
 * 3: uart - jpeg
 * 4: no output measure speed - jpeg
 * */
extern volatile int goutmode;
